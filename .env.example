# Portal configuration. Copy to .env and adjust. All values optional in dev mode.

# --- Environment ---
# dev   = api + runner as local processes, no Caddy, no TLS
# prod  = single Linux host, systemd + Caddy + per-tenant rootless users (see ops/)
PORTAL_ENV=dev

# --- State store ---
PORTAL_DATA_DIR=.portal-data
PORTAL_DB_PATH=
PORTAL_LOG_ROOT=

# --- Public URL shape ---
# prod: https://<slug>.portal.dev ; dev: http://localhost:<mapped-port>
PORTAL_PORTAL_DOMAIN=portal.dev
PORTAL_BASE_PROTOCOL=https
PORTAL_DEV_BASE_PROTOCOL=http

# --- Runner / runtime ---
# The runner always builds with Railpack and runs with rootless Podman:
# Portal does the Docker for the developer. Dev runs the same pipeline as
# prod on your machine — see ops/RUNBOOK.md §2a for the local toolchain.
PORTAL_RUNNER_EXECUTOR=podman
# Path to the railpack builder binary (default: railpack on PATH).
RAILPACK_BIN=
# Rootless BuildKit daemon socket for the real pipeline (ops/RUNBOOK.md §2a).
# Leave unset for the RUNBOOK default; set when buildkitd listens elsewhere.
# BUILDKIT_ADDR=unix:///run/user/1000/buildkit/buildkitd.sock

# --- Operator policy defaults ---
PORTAL_QUOTA_MAX_INSTANCES=3
PORTAL_QUOTA_CONCURRENCY=2
PORTAL_QUOTA_CPU=1.0
PORTAL_QUOTA_MEM_MB=1024
PORTAL_EGRESS_RULES_JSON=[]

# --- Idle lifecycle (FR-17) ---
PORTAL_IDLE_STOP_SECONDS=1800

# --- Secrets (AD-9) ---
# Runner keypair path. In prod the file is readable only by the runner user.
PORTAL_RUNNER_KEY_PATH=
PORTAL_API_KEY_PATH=